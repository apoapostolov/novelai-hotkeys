{
  "manifest_version": 3,
  "name": "NovelAI Hotkeys",
  "version": "1.0.0",
  "description": "On novelai.net/image press G to generate the next image and H to save it. All shortcuts are customizable.",
  "browser_specific_settings": {
    "gecko": {
      "id": "novelai-hotkeys@apoapostolov",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://novelai.net/*",
    "https://www.novelai.net/*",
    "https://static.novelai.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://novelai.net/image*",
        "https://www.novelai.net/image*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "NovelAI Hotkeys - click to customize",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
